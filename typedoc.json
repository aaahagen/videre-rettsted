{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/lib/types.ts",
    "src/lib/database.ts",
    "src/lib/routing-engine.ts",
    "src/lib/volumetrics.ts",
    "src/lib/auth.ts",
    "src/lib/db"
  ],
  "entryPointStrategy": "expand",
  "out": "docs/api",
  "name": "VIDERE RettSted Internal API",
  "readme": "none",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "plugin": ["typedoc-plugin-markdown"],
  "hideGenerator": true,
  "gitRevision": "main"
}
