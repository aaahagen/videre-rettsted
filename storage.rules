rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if the file is an image and under 5MB
    function isValidImage() {
      return request.resource == null || (request.resource.contentType.matches('image/.*')
          && request.resource.size < 5 * 1024 * 1024);
    }
    
    // Helper function for general documents under 50MB
    function isValidMedia() {
       return request.resource == null || (request.resource.size < 50 * 1024 * 1024);
    }

    // User-specific storage (Avatars, documents, etc.)
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId && isValidMedia();
    }

    // Organizations path matching
    match /organizations/{orgId}/{allPaths=**} {
       allow read: if request.auth != null;
       allow write: if request.auth != null && isValidMedia();
    }

    // Reports path matching (Avvikshåndtering)
    match /reports/{orgId}/{allPaths=**} {
       allow read: if request.auth != null;
       allow write: if request.auth != null && isValidImage();
    }

    // Legacy/Shared paths
    match /places/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isValidImage();
    }
    
    match /vehicles/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isValidMedia(); 
    }
  }
}