[debug] [2026-05-14T15:21:54.277Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    function isUserInOrg(orgId) {\n      return isAuthenticated() && \n             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == orgId;\n    }\n\n    function getUserRole() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;\n    }\n\n    function isAdmin() {\n      let role = getUserRole();\n      return role == 'admin' || role == 'super_admin' || role == 'owner';\n    }\n\n    function isSuperAdmin() {\n      return getUserRole() == 'super_admin';\n    }\n\n    function isHmsResponsible() {\n      return getUserRole() == 'hms_responsible';\n    }\n\n    function isSalesman() {\n      return getUserRole() == 'salesman';\n    }\n\n    // Default deny\n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n    // === ORGANIZATIONS ===\n    match /organizations/{orgId} {\n      allow read: if isUserInOrg(orgId) || isSuperAdmin();\n      allow create: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == request.resource.data.ownerId);\n      allow update: if (isUserInOrg(orgId) && isAdmin()) || isSuperAdmin();\n      allow delete: if isSuperAdmin();\n    }\n\n    // === USERS ===\n    match /users/{userId} {\n      // A user can read their own profile, ANY user in their org can read other users in that org, and super_admins can read all.\n      allow read: if request.auth.uid == userId || isUserInOrg(resource.data.orgId) || isSuperAdmin();\n      // Allow creation during sign-up process (requires checking invitation logic in Cloud Functions normally, but for now we allow if auth matches)\n      allow create: if isAuthenticated() && request.auth.uid == userId;\n      // Allow updates if it's their own profile OR they are an admin in the same org OR they are a super_admin\n      allow update: if (isAuthenticated() && request.auth.uid == userId) || \n                       (isUserInOrg(resource.data.orgId) && isAdmin()) ||\n                       isSuperAdmin();\n      // Allow deletion if they are an admin in the same org OR they are a super_admin\n      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();\n    }\n\n    // === INVITATIONS ===\n    match /invitations/{inviteId} {\n      // Anyone can read an invitation to accept it\n      allow read: if true;\n      // Only admins/owners/super_admins can create\n      allow create: if isAuthenticated() && (\n        (isUserInOrg(request.resource.data.organizationId) && isAdmin()) || \n        isSuperAdmin()\n      );\n      // Only admins/super_admins can delete (or cloud functions when accepted)\n      allow delete: if isAuthenticated() && (\n        (isUserInOrg(resource.data.organizationId) && isAdmin()) || \n        isSuperAdmin()\n      );\n    }\n\n    // === PLACES ===\n    match /places/{placeId} {\n      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();\n      allow create: if (isUserInOrg(request.resource.data.orgId) && !isHmsResponsible()) || isSuperAdmin();\n      allow update: if isUserInOrg(resource.data.orgId) || isSuperAdmin();\n      allow delete: if (isUserInOrg(resource.data.orgId) && !isHmsResponsible() && !isSalesman()) || isSuperAdmin();\n    }\n\n    // === REPORTS (AVVIK) ===\n    match /reports/{reportId} {\n      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();\n      allow create: if isUserInOrg(request.resource.data.orgId) || isSuperAdmin();\n      allow update: if isUserInOrg(resource.data.orgId) || isSuperAdmin();\n      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();\n    }\n\n    // ===