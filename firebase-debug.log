S ===\n    match /vehicleDamages/{damageId} {\n      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();\n      allow create: if isUserInOrg(request.resource.data.orgId) || isSuperAdmin();\n      allow update: if isUserInOrg(resource.data.orgId) || isSuperAdmin();\n      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();\n    }\n\n    // === WORK LOGS ===\n    match /workLogs/{logId} {\n      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();\n      allow create: if isUserInOrg(request.resource.data.orgId) || isSuperAdmin();\n      allow update: if isUserInOrg(resource.data.orgId) || isSuperAdmin();\n      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();\n    }\n\n    // === MESSAGES ===\n    match /messages/{messageId} {\n      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();\n      allow create: if isUserInOrg(request.resource.data.orgId) || isSuperAdmin();\n      allow update: if isUserInOrg(resource.data.orgId) || isSuperAdmin();\n      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();\n    }\n\n    // === COURSES ===\n    match /courses/{courseId} {\n      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();\n      allow create: if (isUserInOrg(request.resource.data.orgId) && isAdmin()) || isSuperAdmin();\n      allow update: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();\n      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();\n    }\n\n    // === COURSE ASSIGNMENTS ===\n    match /courseAssignments/{assignmentId} {\n      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();\n      allow create: if (isUserInOrg(request.resource.data.orgId) && isAdmin()) || isSuperAdmin();\n      allow update: if isUserInOrg(resource.data.orgId) || isSuperAdmin(); // Users need to update their own progress\n      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();\n    }\n\n    // === SYSTEM LOGS ===\n    match /logs/{logId} {\n      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();\n      allow create: if isUserInOrg(request.resource.data.orgId) || isSuperAdmin();\n      allow update: if false; // Logs should be immutable\n      allow delete: if isSuperAdmin();\n    }\n\n  }\n}"}]}}
