rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUserInOrg(orgId) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == orgId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      let role = getUserRole();
      return role == 'admin' || role == 'super_admin' || role == 'owner';
    }

    function isSuperAdmin() {
      return getUserRole() == 'super_admin';
    }

    function isHmsResponsible() {
      return getUserRole() == 'hms_responsible';
    }

    function isSalesman() {
      return getUserRole() == 'salesman';
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // === ORGANIZATIONS ===
    match /organizations/{orgId} {
      allow read: if isUserInOrg(orgId) || isSuperAdmin();
      allow create: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == request.resource.data.ownerId);
      allow update: if (isUserInOrg(orgId) && isAdmin()) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // === USERS ===
    match /users/{userId} {
      // A user can read their own profile, ANY user in their org can read other users in that org, and super_admins can read all.
      allow read: if request.auth.uid == userId || isUserInOrg(resource.data.orgId) || isSuperAdmin();
      // Allow creation during sign-up process (requires checking invitation logic in Cloud Functions normally, but for now we allow if auth matches)
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Allow updates if it's their own profile OR they are an admin in the same org OR they are a super_admin
      allow update: if (isAuthenticated() && request.auth.uid == userId) || 
                       (isUserInOrg(resource.data.orgId) && isAdmin()) ||
                       isSuperAdmin();
      // Allow deletion if they are an admin in the same org OR they are a super_admin
      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
    }

    // === INVITATIONS ===
    match /invitations/{inviteId} {
      // Anyone can read an invitation to accept it
      allow read: if true;
      // Only admins/owners/super_admins can create
      allow create: if isAuthenticated() && (
        (isUserInOrg(request.resource.data.organizationId) && isAdmin()) || 
        isSuperAdmin()
      );
      // Only admins/super_admins can delete (or cloud functions when accepted)
      allow delete: if isAuthenticated() && (
        (isUserInOrg(resource.data.organizationId) && isAdmin()) || 
        isSuperAdmin()
      );
    }

    // === PLACES ===
    match /places/{placeId} {
      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if (isUserInOrg(request.resource.data.orgId) && !isHmsResponsible()) || isSuperAdmin();
      allow update: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow delete: if (isUserInOrg(resource.data.orgId) && !isHmsResponsible() && !isSalesman()) || isSuperAdmin();
    }

    // === REPORTS (AVVIK) ===
    match /reports/{reportId} {
      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if isUserInOrg(request.resource.data.orgId) || isSuperAdmin();
      allow update: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
    }

    // === ROUTES ===
    match /routes/{routeId} {
      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if isUserInOrg(request.resource.data.orgId) || isSuperAdmin();
      allow update: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow delete: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
    }

    // === ORDERS ===
    match /orders/{orderId} {
      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if isUserInOrg(request.resource.data.orgId) || isSuperAdmin();
      allow update: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow delete: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
    }

    // === MANIFESTS ===
    match /manifests/{manifestId} {
      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if isUserInOrg(request.resource.data.orgId) || isSuperAdmin();
      allow update: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow delete: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
    }

    // === VEHICLES ===
    match /vehicles/{vehicleId} {
      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if (isUserInOrg(request.resource.data.orgId) && isAdmin()) || isSuperAdmin();
      allow update: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
    }

    // === VEHICLE INSPECTIONS ===
    match /vehicleInspections/{inspectionId} {
      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if isUserInOrg(request.resource.data.orgId) || isSuperAdmin();
      allow update: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
    }

    // === VEHICLE DAMAGES ===
    match /vehicleDamages/{damageId} {
      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if isUserInOrg(request.resource.data.orgId) || isSuperAdmin();
      allow update: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
    }

    // === WORK LOGS ===
    match /workLogs/{logId} {
      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if isUserInOrg(request.resource.data.orgId) || isSuperAdmin();
      allow update: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
    }

    // === MESSAGES ===
    match /messages/{messageId} {
      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if isUserInOrg(request.resource.data.orgId) || isSuperAdmin();
      allow update: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
    }

    // === COURSES ===
    match /courses/{courseId} {
      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if (isUserInOrg(request.resource.data.orgId) && isAdmin()) || isSuperAdmin();
      allow update: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
    }

    // === COURSE ASSIGNMENTS ===
    match /courseAssignments/{assignmentId} {
      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if (isUserInOrg(request.resource.data.orgId) && isAdmin()) || isSuperAdmin();
      allow update: if isUserInOrg(resource.data.orgId) || isSuperAdmin(); // Users need to update their own progress
      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
    }

    // === SYSTEM LOGS ===
    match /logs/{logId} {
      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if isUserInOrg(request.resource.data.orgId) || isSuperAdmin();
      allow update: if false; // Logs should be immutable
      allow delete: if isSuperAdmin();
    }

  }
}