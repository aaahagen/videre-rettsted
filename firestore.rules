rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isUserInOrg(orgId) {
      return getUserData().orgId == orgId;
    }
    
    function isAdmin() {
      return getUserData().role == 'admin';
    }

    // Organizations
    match /organizations/{orgId} {
      // Allow read/write for manifests subcollection for users in the org
      match /manifests/{manifestId} {
        allow read: if isAuthenticated() && isUserInOrg(orgId);
        allow write: if isAuthenticated() && isUserInOrg(orgId) && (isAdmin() || getUserData().role == 'loader');
      }
      
      // Allow read/write for orders subcollection
      match /orders/{orderId} {
        allow read: if isAuthenticated() && isUserInOrg(orgId);
        allow write: if isAuthenticated() && isUserInOrg(orgId) && (isAdmin() || getUserData().role == 'loader');
      }

      allow read: if isAuthenticated() && isUserInOrg(orgId);
      allow create: if isAuthenticated(); 
      allow update: if isAuthenticated() && isUserInOrg(orgId) && isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && 
         request.resource.data.role == resource.data.role && 
         request.resource.data.orgId == resource.data.orgId) || 
        (isAdmin() && isUserInOrg(resource.data.orgId))
      );
      allow delete: if isAuthenticated() && isAdmin() && isUserInOrg(resource.data.orgId);
    }

    // Invitations
    match /invitations/{invitationId} {
      allow get: if true;
      allow list: if isAuthenticated() && isAdmin();
      allow create: if isAuthenticated() && isAdmin(); 
      allow update: if false;
      allow delete: if isAuthenticated() && isAdmin() && (resource == null || isUserInOrg(resource.data.orgId));
    }

    // Places
    match /places/{placeId} {
      allow read: if isAuthenticated(); 
      allow create: if isAuthenticated() && isUserInOrg(request.resource.data.orgId);
      allow update: if isAuthenticated() && isUserInOrg(request.resource.data.orgId);
      allow delete: if isAuthenticated() && isUserInOrg(request.resource.data.orgId) && isAdmin();
    }

    // Routes
    match /routes/{routeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isUserInOrg(request.resource.data.orgId) && isAdmin();
      allow update: if isAuthenticated() && isUserInOrg(request.resource.data.orgId) && (
        isAdmin() || (request.auth.uid == resource.data.driverId)
      );
      allow delete: if isAuthenticated() && isUserInOrg(request.resource.data.orgId) && isAdmin();
    }

    // Messages
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isUserInOrg(request.resource.data.orgId);
      allow update: if isAuthenticated() && isUserInOrg(request.resource.data.orgId);
      allow delete: if isAuthenticated() && isUserInOrg(request.resource.data.orgId) && (isAdmin() || request.auth.uid == resource.data.senderId);
    }

    // Vehicles
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isUserInOrg(request.resource.data.orgId) && isAdmin();
      allow update: if isAuthenticated() && isUserInOrg(request.resource.data.orgId) && isAdmin();
      allow delete: if isAuthenticated() && isUserInOrg(request.resource.data.orgId) && isAdmin();
    }

    // WorkLogs
    match /workLogs/{logId} {
      allow read: if isAuthenticated() && (
        (resource == null) || 
        (request.auth.uid == resource.data.driverId) || 
        (isAdmin() && isUserInOrg(resource.data.orgId))
      );
      
      allow create: if isAuthenticated() && 
        request.resource.data.driverId == request.auth.uid &&
        isUserInOrg(request.resource.data.orgId);
        
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.driverId) || 
        (isAdmin() && isUserInOrg(request.resource.data.orgId))
      );
      
      allow delete: if isAuthenticated() && isAdmin() && isUserInOrg(resource.data.orgId);
    }

    // LMS - Courses
    match /courses/{courseId} {
      allow read: if isAuthenticated() && isUserInOrg(resource.data.orgId);
      allow create: if isAuthenticated() && isUserInOrg(request.resource.data.orgId) && isAdmin();
      allow update: if isAuthenticated() && isUserInOrg(request.resource.data.orgId) && isAdmin();
      allow delete: if isAuthenticated() && isUserInOrg(request.resource.data.orgId) && isAdmin();
    }

    // LMS - Course Assignments
    match /courseAssignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        (resource == null) ||
        (request.auth.uid == resource.data.userId) || 
        (isAdmin() && isUserInOrg(resource.data.orgId))
      );
      allow create: if isAuthenticated() && isUserInOrg(request.resource.data.orgId) && isAdmin();
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.userId) || 
        (isAdmin() && isUserInOrg(resource.data.orgId))
      );
      allow delete: if isAuthenticated() && isUserInOrg(resource.data.orgId) && isAdmin();
    }

    // Audit Logs
    match /logs/{logId} {
      allow read: if isAuthenticated() && isAdmin() && isUserInOrg(resource.data.orgId);
      allow create: if isAuthenticated() && isUserInOrg(request.resource.data.orgId);
      allow update: if false;
      allow delete: if false;
    }
  }
}