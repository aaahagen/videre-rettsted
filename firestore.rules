 rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUserInOrg(orgId) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == orgId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      let role = getUserRole();
      return role == 'admin' || role == 'super_admin' || role == 'owner';
    }

    function isSuperAdmin() {
      return getUserRole() == 'super_admin';
    }

    function isHmsResponsible() {
      return getUserRole() == 'hms_responsible';
    }

    function isSalesman() {
      return getUserRole() == 'salesman';
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // === ORGANIZATIONS ===
    match /organizations/{orgId} {
      allow read: if isUserInOrg(orgId) || isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if (isUserInOrg(orgId) && isAdmin()) || isSuperAdmin();
      allow delete: if isSuperAdmin();

      // Nested collection for Orders
      match /orders/{orderId} {
        allow read: if isUserInOrg(orgId) || isSuperAdmin();
        allow create: if isUserInOrg(orgId) || isSuperAdmin();
        allow update: if isUserInOrg(orgId) || isSuperAdmin();
        allow delete: if isUserInOrg(orgId) || isSuperAdmin();
      }

      // Nested collection for Manifests
      match /manifests/{manifestId} {
        allow read: if isUserInOrg(orgId) || isSuperAdmin();
        allow create: if isUserInOrg(orgId) || isSuperAdmin();
        allow update: if isUserInOrg(orgId) || isSuperAdmin();
        allow delete: if isUserInOrg(orgId) || isSuperAdmin();
      }
    }

    // === USERS ===
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if (isAuthenticated() && request.auth.uid == userId) || 
                       (isUserInOrg(resource.data.orgId) && isAdmin()) ||
                       isSuperAdmin();
      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
    }

    // === INVITATIONS ===
    match /invitations/{inviteId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        (isUserInOrg(request.resource.data.orgId) && isAdmin()) || 
        isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        (isUserInOrg(resource.data.orgId) && isAdmin()) || 
        isSuperAdmin()
      );
    }

    // === PLACES ===
    match /places/{placeId} {
      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if (isUserInOrg(request.resource.data.orgId) && !isHmsResponsible()) || isSuperAdmin();
      allow update: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow delete: if (isUserInOrg(resource.data.orgId) && !isHmsResponsible() && !isSalesman()) || isSuperAdmin();
    }

    // === REPORTS (AVVIK) ===
    match /reports/{reportId} {
      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if isUserInOrg(request.resource.data.orgId) || isSuperAdmin();
      allow update: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
    }

    // === ROUTES ===
    match /routes/{routeId} {
      allow read: if isAuthenticated() && (isUserInOrg(resource.data.orgId) || isSuperAdmin());
      allow create: if isAuthenticated() && (isUserInOrg(request.resource.data.orgId) || isSuperAdmin());
      allow update: if isAuthenticated() && (isUserInOrg(resource.data.orgId) || isSuperAdmin());
      allow delete: if isAuthenticated() && (isUserInOrg(resource.data.orgId) || isSuperAdmin());
    }

    // === VEHICLES ===
    match /vehicles/{vehicleId} {
      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if (isUserInOrg(request.resource.data.orgId) && isAdmin()) || isSuperAdmin();
      allow update: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
    }

    // === VEHICLE INSPECTIONS ===
    match /vehicleInspections/{inspectionId} {
      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if isUserInOrg(request.resource.data.orgId) || isSuperAdmin();
      allow update: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
    }

    // === VEHICLE DAMAGES ===
    match /vehicleDamages/{damageId} {
      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if isUserInOrg(request.resource.data.orgId) || isSuperAdmin();
      allow update: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
    }

    // === WORK LOGS ===
    match /workLogs/{logId} {
      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if isUserInOrg(request.resource.data.orgId) || isSuperAdmin();
      allow update: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
    }

    // === MESSAGES ===
    match /messages/{messageId} {
      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if isUserInOrg(request.resource.data.orgId) || isSuperAdmin();
      allow update: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
    }

    // === COURSES ===
    match /courses/{courseId} {
      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if (isUserInOrg(request.resource.data.orgId) && isAdmin()) || isSuperAdmin();
      allow update: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
    }

    // === COURSE ASSIGNMENTS ===
    match /courseAssignments/{assignmentId} {
      allow read: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow create: if (isUserInOrg(request.resource.data.orgId) && isAdmin()) || isSuperAdmin();
      allow update: if isUserInOrg(resource.data.orgId) || isSuperAdmin();
      allow delete: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
    }

    // === AUDIT LOGS (GDPR) ===
    match /audit_logs/{logId} {
      allow read: if (isUserInOrg(resource.data.orgId) && isAdmin()) || isSuperAdmin();
      allow create: if isUserInOrg(request.resource.data.orgId) || isSuperAdmin();
      allow update: if false; // Audit logs are immutable
      allow delete: if isSuperAdmin(); // Only global owner can purge old logs
    }
  }
}